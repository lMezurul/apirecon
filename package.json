{
    "name":  "apirecon",
    "version":  "0.1.0",
    "description":  "See the API behind the page: network capture, GraphQL introspection, JS endpoint mining and a self-contained HTML report.",
    "type":  "module",
    "bin":  {
                "apirecon":  "dist/cli.js"
            },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
