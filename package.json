                     "puppeteer",
                     "reverse-engineering"
                 ],
    "license":  "MIT",
    "dependencies":  {
                         "puppeteer-core":  "^25.16.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.6",
                            "typescript":  "^7.0.2"
                        }
}
