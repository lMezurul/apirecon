                    "scan":  "node dist/cli.js",
                    "demo":  "node demo/server.mjs",
                    "test":  "node --test test/report.test.mjs"
                },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "keywords":  [
                     "api",
                     "recon",
                     "graphql",
